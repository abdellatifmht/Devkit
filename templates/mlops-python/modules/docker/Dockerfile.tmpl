FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .

COPY models ./models

RUN useradd --create-home app && chown -R app:app /app
USER app

EXPOSE 8000

{{- if eq .serving "fastapi" }}
CMD ["python", "-m", "{{ .project_module }}", "serve"]
{{- else }}
CMD ["python", "-m", "{{ .project_module }}", "train"]
{{- end }}
