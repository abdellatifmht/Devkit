from {{ .project_module }}.config import settings
from {{ .project_module }}.data import load_dataset
from {{ .project_module }}.predict import predict
from {{ .project_module }}.train import train


def test_dataset_split():
    X_train, X_test, y_train, y_test = load_dataset()
    assert len(X_train) > len(X_test)
    assert len(y_train) == len(X_train)
    assert len(y_test) == len(X_test)


def test_train_and_predict(tmp_path, monkeypatch):
    monkeypatch.setattr(settings, "model_path", tmp_path / "model.joblib")
{{- if eq .tracking "mlflow" }}
    monkeypatch.setenv("MLFLOW_ALLOW_FILE_STORE", "true")
    monkeypatch.setattr(settings, "mlflow_tracking_uri", (tmp_path / "mlruns").as_uri())
{{- end }}
    assert train() > 0.5
    assert predict([5.1, 3.5, 1.4, 0.2]) in {0, 1, 2}
{{- if eq .serving "fastapi" }}


def test_health():
    from fastapi.testclient import TestClient

    from {{ .project_module }}.api import app as api_app

    with TestClient(api_app) as client:
        assert client.get("/health").json() == {"status": "ok"}
{{- end }}
