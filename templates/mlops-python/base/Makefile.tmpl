.PHONY: install train predict test{{ if eq .serving "fastapi" }} serve{{ end }}

install:
	pip install -e ".[dev]"

train:
	python -m {{ .project_module }} train

predict:
	python -m {{ .project_module }} predict 5.1 3.5 1.4 0.2
{{- if eq .serving "fastapi" }}

serve:
	python -m {{ .project_module }} serve
{{- end }}
{{- if has .tools "pytest" }}

test:
	pytest
{{- end }}
