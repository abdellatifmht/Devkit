import pytest
from fastapi.testclient import TestClient

from {{ .project_module }}.main import app


@pytest.fixture()
def client():
    with TestClient(app) as test_client:
        yield test_client


def test_health(client):
    response = client.get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}


def test_create_and_get_item(client):
    response = client.post("/items", json={"name": "café", "price": 3.5})
    assert response.status_code == 201
    item = response.json()
    assert item["name"] == "café"
    assert item["price"] == 3.5
    assert client.get(f"/items/{item['id']}").status_code == 200


def test_delete_item(client):
    created = client.post("/items", json={"name": "thé", "price": 2.0}).json()
    assert client.delete(f"/items/{created['id']}").status_code == 204
    assert client.get(f"/items/{created['id']}").status_code == 404
