{
  "name": "{{ .project_slug }}",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
{{- if has .tools "vitest" }}
    "test": "vitest run",
{{- end }}
{{- if ne .database "none" }}
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
{{- end }}
    "format": "prettier --write ."
  },
  "dependencies": {
{{- if ne .database "none" }}
    "@prisma/client": "^6.3.1",
{{- end }}
    "clsx": "^2.1.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.2",
{{- if ne .database "none" }}
    "prisma": "^6.3.1",
{{- end }}
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
{{- if has .tools "vitest" }}
    "vitest": "^3.0.5",
{{- end }}
    "prettier": "^3.5.0"
  }
}
