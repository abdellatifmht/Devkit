spring:
  application:
    name: {{ .project_slug }}
  config:
    import: optional:file:.env[.properties]
  datasource:
{{- if eq .database "postgres" }}
    url: "${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/app}"
    username: "${SPRING_DATASOURCE_USERNAME:app}"
    password: "${SPRING_DATASOURCE_PASSWORD:app}"
{{- else }}
    url: "jdbc:h2:mem:{{ .project_module }};DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE"
    driver-class-name: org.h2.Driver
    username: sa
    password:
{{- end }}
  jpa:
    hibernate:
      ddl-auto: update
    open-in-view: false
{{- if eq .database "h2" }}
  h2:
    console:
      enabled: true
      path: /h2-console
{{- end }}

server:
  port: "${SERVER_PORT:8080}"
