{{- if or (eq .database "postgres") (has .tools "docker") }}
services:
{{- if eq .database "postgres" }}
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: app
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
    ports:
      - "5432:5432"
    volumes:
      - db-data:/var/lib/postgresql/data
{{- end }}
{{- if has .tools "docker" }}
  app:
    build: .
    ports:
      - "8080:8080"
    environment:
      SERVER_PORT: "8080"
{{- if eq .database "postgres" }}
      SPRING_DATASOURCE_URL: jdbc:postgresql://db:5432/app
      SPRING_DATASOURCE_USERNAME: app
      SPRING_DATASOURCE_PASSWORD: app
    depends_on:
      - db
{{- end }}
{{- end }}
{{- if eq .database "postgres" }}
volumes:
  db-data:
{{- end }}
{{- end }}
